# Служебные файлы Python: появляются, когда скрипты движка запускаются в сессии
__pycache__/
*.py[cod]

# Личные настройки Claude Code и рабочие копии — не часть базы
.claude/settings.local.json
.claude/worktrees/

# Если база скачана на Mac
.DS_Store

# Секреты: токены живут в окружении облака, не в базе; это страховка от случайного коммита
.env
.env.*
secrets/
